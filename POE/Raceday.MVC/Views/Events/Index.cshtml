@model IEnumerable<RaceDay.MVC.ViewModels.EventViewModel>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 style="color: #00ffff;">MANAGE RACES & EVENTS</h1>
        <a asp-action="Create" class="btn btn-custom">[ CREATE NEW EVENT ]</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background-color: #008b8b; border-color: #00ffff; color: white;">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center mt-5">
            <h3>You haven't created any events yet.</h3>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-custom table-bordered">
                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>
                            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@item.EventLocation</td>
                            <td>@item.EventType</td>
                            <td>
                                <!-- These links will be wired up in the next steps -->
                                <a href="#" class="btn btn-sm btn-custom" style="border-color: #00ffff; color: #00ffff;">Edit</a>
                                <a href="#" class="btn btn-sm btn-custom" style="border-color: #ffcc00; color: #ffcc00;">Categories</a>
                                <a href="#" class="btn btn-sm btn-custom" style="border-color: #ff0000; color: #ff0000;">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>