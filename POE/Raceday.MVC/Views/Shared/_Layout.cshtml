<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay.MVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark custom-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-white fw-bold" asp-controller="Home" asp-action="Index" style="font-size: 1.5rem;">RACEDAY</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-center gap-2">
                        @{
                            var userRole = Context.Session.GetString("UserRole");
                        }

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">HOME</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Events" asp-action="Index">EVENTS</a>
                        </li>

                        <!-- Participant Links -->
                        @if (userRole == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Enrollments" asp-action="MyEnrollments">ENROLMENTS</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Results" asp-action="MyResults">MY RESULTS</a>
                            </li>
                        }

                        <!-- Organiser Links -->
                        @if (userRole == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Categories" asp-action="Index">CATEGORIES</a>
                            </li>
                        }

                        @if (userRole != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Users" asp-action="Profile">SETTINGS</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (userRole != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold" asp-controller="Auth" asp-action="Logout">LOG OUT</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Auth" asp-action="Login">SIGN IN</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Auth" asp-action="Register">REGISTER</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center">
            &copy; 2026 - Raceday.MVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>